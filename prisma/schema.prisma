// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid())
  name       String   
  email      String   @unique 
  password   String   
  role       String   @default("relawan")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  blockedTokens BlockedToken[]
  santunan  Santunan[]
}

model BlockedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Mustahik {
  id             String   @id @default(uuid())
  nama           String
  tempatLahir    String
  tanggalLahir   DateTime
  profesi        String
  asnaf          String

  negara         String   @default("Indonesia")
  provinsi       String
  kota           String   // kota / kabupaten
  kecamatan      String
  kelurahan      String
  rt             String?
  rw             String?
  alamat         String

  fotoMustahik   String?  // nama file / url
  ttdMustahik    String?  // nama file / url - tanda tangan penerima
  dokumenLain    String?  // KTP / KK / lainnya

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  santunan       Santunan[]
}

model Santunan {
  id              String   @id @default(uuid())
  nominal         Int
  program         String   // santunan yatim, ibu berdaya, dll
  jenisSantunan   String   // zakat, sedekah, infaq, dll

  ttdPenerima     String?  // url / filename
  dokumentasi     String?  // foto penyerahan

  userId          String
  mustahikId      String

  user            User     @relation(fields: [userId], references: [id])
  mustahik        Mustahik @relation(fields: [mustahikId], references: [id])

  createdAt       DateTime @default(now())
}